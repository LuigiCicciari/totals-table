<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="io.totals-table.viz" extension-version="1.6.2">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Fast data table with correct ratio totals, parameter-driven headers and clean Excel/CSV downloads</description>
    <author name="Luigi Cicciari" email="tableau@cicciari.com" organization="Luigi Cicciari" website="https://github.com/LuigiCicciari/totals-table"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://luigicicciari.github.io/totals-table/index.html</url>
    </source-location>
    <icon></icon>
  </worksheet-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Totals Table</text>
    </resource>
  </resources>
</manifest>
